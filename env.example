# --- Supabase (auth + base de datos + almacenamiento de PDFs)
# Projecte correcte: supabase-copper-ferry → https://rifotccaxuahijyixhup.supabase.co (NO el projecte «renovacions»).
# Les variables NEXT_PUBLIC_ s'incorporen durant la COMPILACIÓ: defineix-les a Production i a Preview abans de desplegar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (cuenta de servicio con Drive API y Sheets API activadas)
# Comparte las hojas con el client_email de la cuenta de servicio.
GOOGLE_SERVICE_ACCOUNT_JSON=
SOURCE_CRM_FILE_ID=1--1SR3M68rc9YEU-Jj3_mMUQfHDSqVwG
# Recomendado: carpeta de Drive donde se guardan las exportaciones diarias "Contratos_AAAAMMDD_HHMMSS.xlsx".
# Si se define, cada sincronización usa la exportación MÁS RECIENTE (SOURCE_CRM_FILE_ID se ignora).
SOURCE_CRM_FOLDER_ID=
SOURCE_CRM_PREFIX=Contratos_
SOURCE_DIARIO_FILE_ID=1ACGpIa8MWW14BFUOUCxmeIOM3Rh8E8tI
# Opcional (bidireccional): ID de una Google Sheet NATIVA donde escribir la columna "ESTADO CRM"
WRITEBACK_SHEET_ID=
WRITEBACK_TAB=Contratos

# --- Email corporativo (IONOS)
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Assessoria 3.0 <info@assessoria30.com>"

# --- IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Copilot IA (Fase 5): control de costos. Sense ANTHROPIC_API_KEY el Copilot respon en mode regles.
AI_COPILOT_DAILY_TOKENS=60000
AI_MONTHLY_BUDGET_EUR=30
AI_COPILOT_PER_MINUTE=8
AI_COPILOT_MAX_STEPS=4
AI_COPILOT_MAX_OUTPUT_TOKENS=900
AI_PRICE_IN_EUR_MTOK=3
AI_PRICE_OUT_EUR_MTOK=15

# --- WhatsApp Business Platform (fase 2, opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Correu corporatiu
# Recomanat: configura'l des del CRM (Configuració → Correu, migració 007). La contrasenya es desa xifrada.
# Les variables SMTP_* només s'usen si al CRM no hi ha cap configuració activa.
# Opcional: clau pròpia per xifrar secrets desats a la base de dades (si no hi és, se'n deriva una de SUPABASE_SERVICE_ROLE_KEY).
# Si la canvies, caldrà tornar a escriure la contrasenya del correu al CRM.
SETTINGS_ENCRYPTION_KEY=

# --- Cron de Vercel (sincronització Google Drive + enriquiment SIPS)
CRON_SECRET=

# --- Portal SIPS (EAS Renovae) · NOMÉS SERVIDOR. Mai amb prefix NEXT_PUBLIC_.
SIPS_USER=
SIPS_PASSWORD=
# Opcional (per defecte https://eas.renovaenergy.es)
SIPS_BASE_URL=
# Opcionals: vigència de les dades (dies), reintent d'errors (hores), CUPS per execució del cron i concurrència amb el portal
SIPS_TTL_DAYS=7
SIPS_ERROR_RETRY_HOURS=24
SIPS_CRON_LIMIT=12
SIPS_CONCURRENCY=2
# Límits de consultes per usuari i minut
SIPS_RATE_SEARCH_PER_MIN=20
SIPS_RATE_REFRESH_PER_MIN=30
# Opcional: camps addicionals del portal (p. ex. específics del gas) que es volen desar a la fitxa tècnica,
# amb el nom intern del servei Serenity separat per comes. Deixa-ho buit si no se'n coneixen.
SIPS_EXTRA_COLUMNS=
# Rols que poden consultar subministraments EXTERNS (fora del CRM) i cercar per adreça.
# Per defecte només l'equip d'administració (política actual). Afegeix "comercial" si el negoci ho autoritza.
SIPS_EXTERNAL_ROLES=admin,cap_administrativa,administrativa
# APP_ACCESS_KEY ja NO cal: el buscador fa servir la sessió de Supabase de la plataforma.

# --- Comparatives IA (migració 006) · NOMÉS SERVIDOR
# Activa l'extracció de factures amb IA (Anthropic). Si és "false" o falta, només s'usa
# l'extracció de text local (PDF digital) i la revisió manual. No envia dades si no està activat.
INVOICE_AI_ENABLED=false
# Connectors de tarifes autoritzats (APIs oficials o fitxers JSON facilitats per la comercialitzadora).
# Format JSON: [{"id":"proveidor","name":"Nom","kind":"json","url":"https://...","auth":"Bearer ..."}]
# Deixa-ho buit si no hi ha cap integració autoritzada. Mai scraping.
TARIFF_CONNECTORS=

# --- CRM · gestor documental (opcionals)
# Mida màxima per fitxer en MB (per defecte 25, màxim 50)
CRM_DOCS_MAX_MB=25
# Tipus addicionals als bàsics (PDF, JPG, PNG, WebP, DOCX, XLSX), separats per comes.
# Possibles: heic,tif,tiff,doc,xls,csv,txt,eml,msg,zip,odt,ods
CRM_DOCS_EXTRA_TYPES=

# --- Contractació · signatura electrònica (migració 010) · NOMÉS SERVIDOR (opcionals)
# Sense aquestes variables la integració queda «pendent»: es poden preparar sol·licituds però no s'envien
# i cap signatura es dona per bona des del CRM. Proveïdor inclòs: signaturit.
SIGNATURE_PROVIDER=
SIGNATURIT_API_TOKEN=
# sandbox (proves) o production
SIGNATURIT_ENV=sandbox
# Secret per autenticar els avisos (webhooks) del proveïdor. Genera'l amb: openssl rand -base64 32
SIGNATURE_WEBHOOK_SECRET=
# URL pública de la plataforma (per a l'adreça d'avisos), p. ex. https://crm.assessoria30.com
APP_URL=

# --- Captació i màrqueting (Fase 6). Sense credencials, cada integració queda «pendent» (no se simula).
# Dades corporatives de la landing: confirma-les i posa NEXT_PUBLIC_COMPANY_VERIFIED=true per treure l'avís.
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Assessoria 3.0 AE, SL"
NEXT_PUBLIC_COMPANY_WEB=www.assessoria30.com
NEXT_PUBLIC_COMPANY_ADDRESS="Av. Garrigues, 21, local 1, Lleida"
NEXT_PUBLIC_COMPANY_PHONE="973 982 852"
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WHATSAPP=
NEXT_PUBLIC_COMPANY_TAX_ID=
NEXT_PUBLIC_COMPANY_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_VERIFIED=false
# URL pública de la landing (enllaços de referència i QR), p. ex. https://www.assessoria30.com
NEXT_PUBLIC_LANDING_URL=
# Sal per als hash de limitació de peticions (cap IP es desa en clar). Valor aleatori llarg.
CAPTURE_HASH_SALT=
# Comparativa preliminar automàtica en llegir una factura (només esborrany intern): true per defecte
CAPTURE_AUTO_PRELIMINARY=true
# Meta (Lead Ads i webhook de WhatsApp): secret de l'app, testimoni de verificació i token de pàgina
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Google Ads (només lectura de costos)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Fase 10 · Agenda: calendaris externs (OAuth). NOMÉS SERVIDOR. Sense aquestes variables la integració queda
# «no disponible» (mai es mostra com a connectada). Adreces de retorn que cal registrar a cada aplicació OAuth:
#   ${APP_URL}/api/calendar/callback?provider=google    ·    ${APP_URL}/api/calendar/callback?provider=microsoft
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Opcional: identificador del tenant d'Azure (per defecte «common»: comptes de feina i personals)
MICROSOFT_CALENDAR_TENANT=
